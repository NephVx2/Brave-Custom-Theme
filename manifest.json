{
  "manifest_version": 3,
  "name": "Catppuccin Mocha — Brave Custom",
  "short_name": "Catppuccin Mocha",
  "version": "1.0.0",
  "description": "Thème custom Catppuccin (flavor Mocha) pour Brave, config-as-code — inspiré de l'approche Spicetify.",
  "author": "nephren",

  "theme": {
    "images": {
      "theme_ntp_background": "images/ntp_background.png"
    },
    "colors": {
      "frame": [17, 17, 27],
      "frame_inactive": [24, 24, 37],
      "frame_incognito": [50, 38, 49],
      "frame_incognito_inactive": [56, 44, 57],

      "toolbar": [30, 30, 46],
      "toolbar_text": [205, 214, 244],
      "toolbar_button_icon": [203, 166, 247],

      "tab_background_text": [166, 173, 200],
      "tab_background_text_incognito": [166, 173, 200],
      "tab_background_text_incognito_inactive": [166, 173, 200],
      "tab_text": [205, 214, 244],
      "tab_selected": [49, 50, 68],
      "background_tab_incognito": [51, 43, 59],
      "background_tab_incognito_inactive": [45, 38, 51],

      "ntp_background": [30, 30, 46],
      "ntp_text": [205, 214, 244],
      "ntp_link": [137, 180, 250],
      "ntp_header": [69, 71, 90],

      "omnibox_background": [17, 17, 27],
      "omnibox_text": [205, 214, 244],

      "button_background": [49, 50, 68],
      "bookmark_text": [205, 214, 244],

      "toolbar_top_separator": [17, 17, 27],
      "toolbar_bottom_separator": [17, 17, 27],
      "toolbar_vertical_separator": [88, 91, 112]
